<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:local="clr-namespace:Gerencia_Movil"
              x:Class="Gerencia_Movil.MainPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Inicio">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid BackgroundColor="{StaticResource PrimaryColor}"
              Padding="20"
              ColumnDefinitions="*,Auto">

            <VerticalStackLayout>
                <Label Text="Bienvenido"
                       FontSize="14"
                       TextColor="White"/>

                <Label x:Name="LabelBienvenida"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"/>
            </VerticalStackLayout>

            <ImageButton Source="circulo_de_usuario.png"
                         HeightRequest="35"
                         WidthRequest="35"
                         BackgroundColor="Transparent"
                         Clicked="Button_UsuarioDetalle"
                         Grid.Column="1"/>
        </Grid>

        <!-- CONTENIDO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="25">

                <!-- RESUMEN -->
                <Label Text="Resumen"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryColor}"/>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="15">

                    <!-- Tarjeta Actividades -->
                    <Frame BackgroundColor="{StaticResource CardColor}"
                           CornerRadius="12"
                           HasShadow="True"
                           Padding="15">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Actividades"
                                   FontAttributes="Bold"/>
                            <Label x:Name="LabelTotalPendientes"
                                Text="{Binding TotalPendientes}"
                                   FontSize="22"
                                   TextColor="{StaticResource SecondaryColor}"/>
                            <Label Text="Pendientes"
                                   FontSize="12"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Tarjeta Dispositivos -->
                    <Frame BackgroundColor="{StaticResource CardColor}"
                           CornerRadius="12"
                           HasShadow="True"
                           Padding="15"
                           Grid.Column="1">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Dispositivos"
                                   FontAttributes="Bold"/>
                            <Label x:Name="LabelDispositivosUso"
                                Text="{Binding TotalEnUso}"
                                   FontSize="22"
                                   TextColor="{StaticResource SecondaryColor}"/>
                            <Label Text="En uso"
                                   FontSize="12"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <!-- ACCESOS -->
                <Label Text="Accesos rápidos"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryColor}"/>

                <!-- Botón Actividades -->
                <Frame BackgroundColor="{StaticResource CardColor}"
                       CornerRadius="12"
                       HasShadow="True"
                       Padding="20">

                    <HorizontalStackLayout Spacing="15">
                        <Image Source="actividades_icon.png"
                               HeightRequest="40"
                               WidthRequest="40"/>

                        <VerticalStackLayout>
                            <Label Text="Actividades"
                                   FontAttributes="Bold"
                                   FontSize="16"/>
                            <Label Text="Gestiona tus tareas asignadas"
                                   FontSize="13"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>

                        <Button Text="Entrar"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalOptions="EndAndExpand"
                                Clicked="Button_Clicked"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Botón Dispositivos -->
                <Frame BackgroundColor="{StaticResource CardColor}"
                       CornerRadius="12"
                       HasShadow="True"
                       Padding="20">

                    <HorizontalStackLayout Spacing="15">
                        <Image Source="dispositivos_icon.png"
                               HeightRequest="40"
                               WidthRequest="40"/>

                        <VerticalStackLayout>
                            <Label Text="Dispositivos"
                                   FontAttributes="Bold"
                                   FontSize="16"/>
                            <Label Text="Administra equipos asignados"
                                   FontSize="13"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>

                        <Button Text="Entrar"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalOptions="EndAndExpand"
                                Clicked="Button_Clicked_1"/>
                    </HorizontalStackLayout>
                </Frame>

                <!-- CERRAR SESIÓN -->
                <Button Text="Cerrar sesión"
                        BackgroundColor="#DC2626"
                        TextColor="White"
                        CornerRadius="8"
                        Clicked="Button_Close"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>