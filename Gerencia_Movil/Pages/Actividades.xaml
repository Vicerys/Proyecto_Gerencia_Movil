<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gerencia_Movil.Pages.Actividades"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Actividades">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER CORPORATIVO -->
        <Grid BackgroundColor="{StaticResource PrimaryColor}"
              Padding="20"
              ColumnDefinitions="*,Auto">

            <Label 
                Text="Actividades pendientes"
                Style="{StaticResource TitleLabel}"
                TextColor="White"
                VerticalOptions="Center"/>

            <ImageButton 
                Source="circulo_de_usuario.png"
                HeightRequest="35"
                WidthRequest="35"
                BackgroundColor="Transparent"
                Clicked="Button_UsuarioDetalle"
                Grid.Column="1"/>
        </Grid>


        <!-- LISTA -->
        <CollectionView Grid.Row="1" Style="{StaticResource BodyText}"
                        x:Name="TareasCollectionView"
                        ItemsSource="{Binding Tareas}"
                        SelectionMode="None"
                        Margin="15">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <!-- TARJETA CORPORATIVA -->
                    <Frame BackgroundColor="{StaticResource CardColor}"
                           CornerRadius="12"
                           HasShadow="True"
                           Padding="15">

                        <VerticalStackLayout Spacing="10">

                            <!-- Nombre actividad -->
                            <Label 
                                x:Name="LabelTareaNombre"
                                Text="{Binding Nombre}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryColor}"/>

                            <!-- Acciones -->
                            <HorizontalStackLayout 
                                HorizontalOptions="End"
                                Spacing="10">

                                <ImageButton 
                                    Source="mas_detalle.png"
                                    HeightRequest="25"
                                    WidthRequest="25"
                                    BackgroundColor="Transparent"
                                    Clicked="Button_DetallesdeActividad"
                                    CommandParameter="{Binding .}"/>

                                <Button
                                    Text="Completar"
                                    Style="{StaticResource PrimaryButton}"
                                    Clicked="Button_Completar"/>
                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>