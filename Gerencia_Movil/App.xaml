<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Gerencia_Movil"
             x:Class="Gerencia_Movil.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Colores corporativos -->
            <Color x:Key="PrimaryColor">#1E3A8A</Color>
            <Color x:Key="SecondaryColor">#2563EB</Color>
            <Color x:Key="AccentColor">#10B981</Color>
            <Color x:Key="BackgroundColor">#F3F4F6</Color>
            <Color x:Key="CardColor">#FFFFFF</Color>

            <!-- Estilo para títulos -->
            <Style TargetType="Label" x:Key="TitleLabel">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
            </Style>

            <!-- Estilo botones principales -->
            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryColor}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,6"/>
            </Style>

            <Style TargetType="Frame" x:Key="CardStyle">
                <Setter Property="BackgroundColor" Value="{StaticResource CardColor}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HasShadow" Value="True"/>
                <!--    <Setter Property="Padding" Value="{StaticResource CardPadding}"/> -->
            </Style>


            <!-- Títulos grandes -->
                <Style x:Key="TitleLarge" TargetType="Label">
                    <Setter Property="FontFamily" Value="InterSemiBold"/>
                    <Setter Property="FontSize" Value="22"/>
                    <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
                </Style>

                <!-- Títulos sección -->
                <Style x:Key="TitleMedium" TargetType="Label">
                    <Setter Property="FontFamily" Value="InterSemiBold"/>
                    <Setter Property="FontSize" Value="18"/>
                    <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
                </Style>

                <!-- Texto normal -->
                <Style x:Key="BodyText" TargetType="Label">
                    <Setter Property="FontFamily" Value="InterRegular"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="TextColor" Value="#374151"/>
                </Style>

            <x:Double x:Key="SpacingSmall">8</x:Double>
            <x:Double x:Key="SpacingMedium">16</x:Double>
            <x:Double x:Key="SpacingLarge">24</x:Double>
            <x:Double x:Key="PagePadding">20</x:Double>
            <!-- <x:Double x:Key="CardPadding">16</x:Double> -->

        </ResourceDictionary>
    </Application.Resources>
</Application>

    